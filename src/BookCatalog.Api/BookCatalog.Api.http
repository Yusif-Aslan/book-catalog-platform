@host = https://localhost:7134
@missingId = 00000000-0000-0000-0000-000000000001

### 1a. Create book: Clean Code
POST {{host}}/api/books
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "isbn": "978-0-13-235088-4",
  "publishedYear": 2008,
  "genre": "Programming"
}

> {%
    client.test("Book created", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("bookId", response.body.id);
%}

### 1b. Create book: Design Patterns
POST {{host}}/api/books
Content-Type: application/json

{
  "title": "Design Patterns",
  "author": "Erich Gamma",
  "isbn": "0-201-63361-2",
  "publishedYear": 1994,
  "genre": "Programming"
}

> {%
    client.test("Book created", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("designPatternsId", response.body.id);
%}

### 1c. Create book: Refactoring
POST {{host}}/api/books
Content-Type: application/json

{
  "title": "Refactoring",
  "author": "Martin Fowler",
  "isbn": "978-0-13-475759-9",
  "publishedYear": 2018,
  "genre": "Programming"
}

> {%
    client.test("Book created", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("refactoringId", response.body.id);
%}

### 2. Filter by title with paging
GET {{host}}/api/books?title=e&page=1&pageSize=2

> {%
    client.test("Returns one page", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.items.length === 2, "Expected 2 items, got " + response.body.items.length);
    });
%}

### 3. Duplicate ISBN
POST {{host}}/api/books
Content-Type: application/json

{
  "title": "Clean Code (copy)",
  "author": "Robert C. Martin",
  "isbn": "9780132350884",
  "publishedYear": 2008,
  "genre": "Programming"
}

> {%
    client.test("Duplicate ISBN returns 409", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}

### 4a. Update missing book
PUT {{host}}/api/books/{{missingId}}
Content-Type: application/json

{
  "title": "The Pragmatic Programmer",
  "author": "David Thomas, Andrew Hunt",
  "isbn": "978-0-13-595705-9",
  "publishedYear": 2019,
  "genre": "Programming"
}

> {%
    client.test("Update missing returns 404", function () {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}

### 4b. Delete missing book
DELETE {{host}}/api/books/{{missingId}}

> {%
    client.test("Delete missing returns 404", function () {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}

### 5. Get created book
GET {{host}}/api/books/{{bookId}}

> {%
    client.test("Book is found", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 6a. Create book for lending (no ISBN, so it can be created on every run)
POST {{host}}/api/books
Content-Type: application/json

{
  "title": "Lending Test Book",
  "author": "Test Author",
  "publishedYear": 2020,
  "genre": "Test"
}

> {%
    client.test("Lending book created", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("lendingBookId", response.body.id);
%}

### 6b. Add copy with a random inventory number
POST {{host}}/api/books/{{lendingBookId}}/copies
Content-Type: application/json

{
  "inventoryNumber": "INV-{{$random.alphanumeric(8)}}"
}

> {%
    client.test("Copy created", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("copyId", response.body.id);
    client.global.set("inventoryNumber", response.body.inventoryNumber);
%}

### 6c. Duplicate inventory number
POST {{host}}/api/books/{{lendingBookId}}/copies
Content-Type: application/json

{
  "inventoryNumber": "{{inventoryNumber}}"
}

> {%
    client.test("Duplicate inventory number returns 409", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}

### 6d. List copies
GET {{host}}/api/books/{{lendingBookId}}/copies

> {%
    client.test("Copy is available", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.length === 1, "Expected 1 copy, got " + response.body.length);
        client.assert(response.body[0].isAvailable === true, "Expected copy to be available");
    });
%}

### 7a. Borrow copy
POST {{host}}/api/copies/{{copyId}}/borrow
Content-Type: application/json

{
  "borrowerName": "Alice"
}

> {%
    client.test("Borrow returns 201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
%}

### 7b. Borrow the same copy again
POST {{host}}/api/copies/{{copyId}}/borrow
Content-Type: application/json

{
  "borrowerName": "Bob"
}

> {%
    client.test("Double borrow returns 409", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}

### 7c. Return copy
POST {{host}}/api/copies/{{copyId}}/return

> {%
    client.test("Return returns 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.returnedAt !== null, "Expected returnedAt to be set");
    });
%}

### 7d. Return the same copy again
POST {{host}}/api/copies/{{copyId}}/return

> {%
    client.test("Second return returns 409", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}

### 7e. Loan history
GET {{host}}/api/copies/{{copyId}}/loans

> {%
    client.test("History has one loan", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.length === 1, "Expected 1 loan, got " + response.body.length);
    });
%}

